DATABASE_URL="postgresql://workflex:workflex_dev@localhost:5432/workflex?schema=public"
JWT_SECRET="una_cadena_secreta_muy_segura"
JWT_EXPIRES_IN="7d"
PORT=3000

# Correo (Brevo). Si no se configuran, los correos se omiten en modo dev.
# Opción recomendada: API REST (HTTPS/443). Credencial: Settings > SMTP & API > API Keys.
BREVO_API_KEY="xkeysib-..."   # si se define, tiene prioridad sobre el SMTP
# Alternativa: SMTP relay (Settings > SMTP & API > SMTP tab)
MAIL_ENABLED="true"
MAIL_HOST="smtp-relay.brevo.com"
MAIL_PORT=587
MAIL_USER="tu_login_smtp@smtp-brevo.com"   # SMTP login (no uses smtp-relay.brevo.com como login)
MAIL_PASS="tu_smtp_key"                    # SMTP key (NO la API key ni tu contraseña)
MAIL_FROM="WorkFlex <correo_verificado@tudominio.com>"  # Debe estar verificado en Brevo
