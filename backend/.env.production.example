# Copia a .env en producción (Render). Genera el JWT_SECRET con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# PostgreSQL de producción (Supabase free tier)
DATABASE_URL="postgresql://postgres.<tu-proyecto>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?schema=public"

JWT_SECRET="genera_una_cadena_aleatoria_larga"
JWT_EXPIRES_IN="7d"

# Correo (opcional). Con MAIL_ENABLED=false los correos se omiten.
# Opción recomendada: API REST de Brevo (HTTPS/443), más confiable que SMTP desde Render.
# Credencial: Brevo > Settings > SMTP & API > API Keys (formato xkeysib-...)
BREVO_API_KEY="xkeysib-..."
# Alternativa SMTP (solo si BREVO_API_KEY no está definida):
# - MAIL_USER es el SMTP login (formato xxx@smtp-brevo.com), NO el host.
# - MAIL_PASS es la SMTP key, NO la API key ni tu contraseña.
# - MAIL_FROM debe ser un remitente verificado en Brevo (Settings > Senders & IPs).
MAIL_ENABLED="false"
MAIL_HOST="smtp-relay.brevo.com"
MAIL_PORT=587
MAIL_USER="tu_login_smtp@smtp-brevo.com"
MAIL_PASS="tu_smtp_key"
MAIL_FROM="WorkFlex <correo_verificado@tudominio.com>"
