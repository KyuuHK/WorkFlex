# Copia a .env en producción (Render). Genera el JWT_SECRET con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# PostgreSQL de producción (Supabase free tier)
DATABASE_URL="postgresql://postgres.<tu-proyecto>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?schema=public"

JWT_SECRET="genera_una_cadena_aleatoria_larga"
JWT_EXPIRES_IN="7d"

# Correo (opcional). Con MAIL_ENABLED=false los correos se omiten.
MAIL_ENABLED="false"
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USER="tu_correo@gmail.com"
MAIL_PASS="tu_contraseña_de_aplicacion"
MAIL_FROM="WorkFlex <tu_correo@gmail.com>"
